/SpotGF_Multitone_SetStepColor
{
SGFType 1 eq
{
/MultiToStep MultiStepsIndex NMultiSteps div def
/MultiFromStep 1 MultiToStep sub def
/ArrayIndex MarkerIndex def
}
{
